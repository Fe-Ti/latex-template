%% Дополнения из ГОСТ 2.105-2019, которые могут потребоваться при НК ВКР
%
% 6.6.3 Расстояние между заголовком раздела (подраздела) и предыдущим или
% последующим текстом, а также между заголовками раздела и подраздела
% должно быть равно не менее чем двум высотам шрифта, которым набран
% основной текст документа.
%
%Примечание - При выполнении машинописным способом интервал
% рекомендуется использовать равный 2 или 3 интервалам, при выполнении
% рукописным способом - не менее 15 мм.
%%% прим: А в старой версии госта ...-95 было 3 или 4 интервала,
%%% т.е. стоит остановиться на 3 интервалах

% 6.6.4 Расстояние между строками заголовков подразделов и пунктов 
% принимают таким же, как в тексте.

\newcommand{\useGOSTstyleOTKTD}{
	\titlespacing*{\structure}{0pt}{0pt}{3em}
	\titlespacing*{\section}{0pt}{0pt}{3em}
	\titlespacing*{\subsection}{0pt}{3em}{3em}
	\titlespacing*{\subsubsection}{0pt}{3em}{3em}
	\titlespacing*{\paragraph}{0pt}{3em}{3em}
	\titlespacing*{\subparagraph}{0pt}{3em}{3em}
}
% Опционально убираем 1em следующией командой
\newcommand{\titleToTitleSpace}{\vspace{-1em}}

% В гостах не обнаружено, но требуют увеличить расстояние между формулой
% и текстом (до и после формулы)
\newcommand{\enlargeFormulaeSpacing}{
	% Формулы: пустая строка до и после.
	% \AtBeginDocument нужен, потому что setspace (через \onehalfspacing)
	% переопределяет displayskip при выборе шрифта, перезаписывая значения,
	% поставленные в преамбуле.
	\AtBeginDocument{%
		\setlength{\abovedisplayskip}{1.5em}%
		\setlength{\belowdisplayskip}{1.5em}%
		\setlength{\abovedisplayshortskip}{1.5em}%
		\setlength{\belowdisplayshortskip}{1.5em}%
	}
}
